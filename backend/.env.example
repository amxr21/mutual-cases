# Backend environment configuration — copy to .env and fill in real values.
# NEVER commit the real .env. Values here are placeholders/examples only.

# --- Runtime ---
NODE_ENV=development
PORT=3000
# Comma-separated allowlist of frontend origins permitted by CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://mutual-cases.vercel.app

# --- Database (MySQL / AWS RDS) ---
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=mutual
DB_CONNECTION_LIMIT=25
DB_QUEUE_LIMIT=100
# TLS for the DB connection. For a public AWS RDS instance set DB_SSL=true,
# DB_SSL_REJECT_UNAUTHORIZED=true, and point DB_SSL_CA at the RDS CA bundle.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL_CA=
# Keep stacked queries OFF unless you have a specific need (SQLi amplifier).
DB_MULTIPLE_STATEMENTS=false

# --- Auth ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Generate a long random secret, e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
GOOGLE_VERIFY_TIMEOUT_MS=8000

# --- Email (Resend). Leave RESEND_API_KEY blank to log emails instead of sending. ---
RESEND_API_KEY=
EMAIL_FROM=Mutual <onboarding@resend.dev>
PUBLIC_SITE_URL=http://localhost:3001

# --- Cloudinary image uploads (optional; all three required to enable signing) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=mutual

# --- Logging ---
LOG_LEVEL=debug
LOG_CONSOLE=true
